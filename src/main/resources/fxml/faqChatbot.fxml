<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<fx:root type="javafx.scene.layout.BorderPane" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <Label fx:id="roleLabel" text="FAQ - Utilisateur" style="-fx-font-size: 18; -fx-font-weight: bold;">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </Label>
                <Separator />
            </children>
        </VBox>
    </top>
    
    <center>
        <ScrollPane fx:id="chatScrollPane" fitToWidth="true" BorderPane.alignment="CENTER">
            <content>
                <VBox fx:id="chatContainer" minHeight="0.0" minWidth="0.0" />
            </content>
        </ScrollPane>
    </center>
    
    <bottom>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <Separator />
                <Label text="Suggestions rapides:" style="-fx-font-weight: bold;">
                    <padding>
                        <Insets left="10.0" top="5.0" />
                    </padding>
                </Label>
                <ScrollPane fitToHeight="true" maxHeight="60.0" minHeight="60.0">
                    <content>
                        <FlowPane fx:id="suggestionsPane" hgap="5.0" vgap="5.0">
                            <padding>
                                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
                            </padding>
                        </FlowPane>
                    </content>
                </ScrollPane>
                <Separator />
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <TextField fx:id="messageField" promptText="Tapez votre question ici..." HBox.hgrow="ALWAYS" />
                        <Button fx:id="sendButton" text="Envoyer" defaultButton="true" />
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </HBox>
            </children>
        </VBox>
    </bottom>
</fx:root>