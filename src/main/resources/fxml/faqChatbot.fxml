<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<fx:root type="javafx.scene.layout.BorderPane" prefHeight="650.0" prefWidth="800.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" BorderPane.alignment="CENTER">
            <children>
                <Label fx:id="roleLabel" text="💬 Centre d'Aide - Assistant Virtuel" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
                    <padding>
                        <Insets bottom="15.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                </Label>
                <Label text="Posez vos questions, notre assistant est là pour vous aider" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;">
                    <padding>
                        <Insets bottom="15.0" left="20.0" right="20.0" />
                    </padding>
                </Label>
            </children>
        </VBox>
    </top>
    
    <center>
        <ScrollPane fx:id="chatScrollPane" fitToWidth="true" style="-fx-background: white; -fx-background-color: white;" BorderPane.alignment="CENTER">
            <content>
                <VBox fx:id="chatContainer" minHeight="0.0" minWidth="0.0" spacing="10.0" style="-fx-background-color: white; -fx-padding: 20;" />
            </content>
        </ScrollPane>
    </center>
    
    <bottom>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, -2);" BorderPane.alignment="CENTER">
            <children>
                <VBox style="-fx-background-color: #f8f9fa; -fx-padding: 15;">
                    <Label text="💡 Suggestions rapides" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 14px;">
                        <padding>
                            <Insets bottom="10.0" />
                        </padding>
                    </Label>
                    <ScrollPane fitToHeight="true" maxHeight="80.0" minHeight="80.0" style="-fx-background: transparent; -fx-background-color: transparent;">
                        <content>
                            <FlowPane fx:id="suggestionsPane" hgap="8.0" vgap="8.0" />
                        </content>
                    </ScrollPane>
                </VBox>
                <HBox alignment="CENTER" spacing="15.0" style="-fx-background-color: white; -fx-padding: 20;">
                    <children>
                        <TextField fx:id="messageField" promptText="🗨 Tapez votre question ici..." HBox.hgrow="ALWAYS" style="-fx-background-radius: 25; -fx-border-radius: 25; -fx-border-color: #e0e0e0; -fx-padding: 12 20; -fx-font-size: 14px;" />
                        <Button fx:id="sendButton" text="➤ Envoyer" defaultButton="true" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 12 25; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </bottom>
</fx:root>