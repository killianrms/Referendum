<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.DropShadow?>

<fx:root prefHeight="600.0" prefWidth="700.0" type="VBox" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" >
    <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-padding: 20;">
        <Label fx:id="labeltitre" text="Document" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;">
            <font>
                <Font size="20.0" />
            </font>
        </Label>
    </VBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: white; -fx-background-color: white;">
        <TextFlow style="-fx-background-color: white; -fx-padding: 30; -fx-line-spacing: 5;">
            <Text fx:id="labeltext" text="Contenu du document" style="-fx-font-size: 14px; -fx-fill: #34495e;"/>
        </TextFlow>
    </ScrollPane>
</fx:root>

