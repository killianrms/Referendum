stages:
  - build
  - release

build_jars:
  stage: build
  image: maven:3.9.6-eclipse-temurin-21
  script:
    - mvn clean package -DskipTests
  artifacts:
    paths:
      - target/Projet-referendum-Client.jar
      - target/Projet-referendum-Scrutateur.jar

release:
  stage: release
  image: registry.gitlab.com/gitlab-org/release-cli:latest
  needs: [build_jars]
  rules:
    - if: '$CI_COMMIT_TAG'
  script: []
  release:
    tag_name: "$CI_COMMIT_TAG"
    description: "Release automatique des JAR client et scrutateur"
    assets:
      links:
        - name: "Client JAR"
          url: "${CI_PROJECT_URL}/-/jobs/${CI_JOB_ID}/artifacts/file/target/Projet-referendum-Client.jar"
        - name: "Scrutateur JAR"
          url: "${CI_PROJECT_URL}/-/jobs/${CI_JOB_ID}/artifacts/file/target/Projet-referendum-Scrutateur.jar"